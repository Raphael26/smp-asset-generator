# Copy to .env and fill in. Restart the studio after a change.

# Claude, for text improvements, captions, image prompts and reviews
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Replicate, for Flux 2 images and Topaz sharpening
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: keep the database, images and exports somewhere else than ./data
# SMP_DATA_DIR=/Users/you/Documents/smp-studio-data

# Optional: a Chromium browser to use for exports if Google Chrome is not installed
# CHROME_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
